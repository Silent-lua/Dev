local Players = game:GetService("Players")
local player = Players.LocalPlayer

local BLACKLIST_URL = "https://pastefy.app/45lnUGXX/raw"

local function normalizeName(name)
    return string.lower(string.gsub(tostring(name), "^%s*(.-)%s*$", "%1"))
end

local function isBlacklisted()
    local success, blacklist = pcall(function()
        return game:HttpGet(BLACKLIST_URL)
    end)

    if not success or type(blacklist) ~= "string" then
        return false
    end

    local username = normalizeName(player.Name)
    local displayName = normalizeName(player.DisplayName)

    for line in blacklist:gmatch("[^\r\n]+") do
        local blockedName = normalizeName(line)

        if blockedName ~= "" then

            if blockedName == username then
                return true
            end

            if blockedName == displayName then
                return true
            end

        end
    end

    return false
end

if isBlacklisted() then
    return
end

